{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinica-odontics",
  "main": "src/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
